# Runtime mode
NODE_ENV=development

# PostgreSQL (production must require TLS; replace placeholders locally)
DATABASE_URL=postgresql://orb_app:change-me@localhost:5432/orb?sslmode=require

# Immutable S3-compatible evidence storage
OBJECT_STORAGE_ENDPOINT=https://objects.example.invalid
OBJECT_STORAGE_REGION=me-central-1
OBJECT_STORAGE_BUCKET=orb-r1-evidence
OBJECT_STORAGE_ACCESS_KEY_ID=change-me
OBJECT_STORAGE_SECRET_ACCESS_KEY=change-me

# Exact browser origins; comma-separated allow-list includes the application origin
ORB_APP_ORIGIN=https://orb.example.invalid
ORB_ALLOWED_ORIGINS=https://orb.example.invalid

# Fixed Release 1 session policy (30-minute idle, 12-hour absolute)
AUTH_IDLE_MINUTES=30
AUTH_ABSOLUTE_MINUTES=720

# Base64-encoded 32-byte key; never commit a real value
ENCRYPTION_KEY_BASE64=REPLACE_WITH_BASE64_32_BYTE_KEY

# Internal observability and recovery control-plane endpoints
TELEMETRY_ENDPOINT=https://telemetry.example.invalid
BACKUP_STATUS_ENDPOINT=https://backup.example.invalid/status
