{
  "name": "orb-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prisma:generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/**/*.test.ts",
    "build": "next build",
    "release:sbom": "node scripts/generate-sbom.mjs",
    "release:health": "ops/release/check-candidate-health.sh",
    "release:verify": "ops/release/verify-candidate.sh",
    "release:freeze": "ops/release/freeze-candidate.sh --freeze"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@mui/material": "9.5.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@tanstack/react-table": "9.3.1",
    "prisma": "7.10.1",
    "@prisma/client": "7.10.1",
    "zod": "4.6.7",
    "better-auth": "1.7.18",
    "pg": "8.16.3",
    "@aws-sdk/client-s3": "3.1162.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "24.19.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "vitest": "5.1.0",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.4"
  },
  "engines": {
    "node": "24.22.2",
    "pnpm": "12.16.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "error"
    }
  }
